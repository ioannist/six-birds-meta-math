import SixBirdsMetaMath.FoundationsIV.Transport.DescentRepair

/-!
F51 Unification as Common Refinement.

Unification is modeled as a formed parent package whose projections recover two
law packages as quotient shadows. The normal form separates weak common-parent
unification from substantive unification: exact unification requires object
projection, law/status carriage, transport preservation, role preservation, and
cross-residual closure; substantive unification additionally needs non-product
structure or compression.
-/

namespace SixBirdsMetaMath.FoundationsIV.SelfReferenceLimits.Unification

open SixBirdsMetaMath.FoundationsIV.Transport.DescentRepair

/-- Object projection from a candidate parent package to an old package:
the old object quotient descends through the parent quotient. -/
def ObjectProjectionDescends {HU QU HOld QOld : Type} (qU : HU → QU)
    (interpret : HU → HOld) (qOld : HOld → QOld) : Prop :=
  Descends qU interpret qOld

/-- Object-projection obstruction: parent-identical states have different old
object shadows. -/
def ObjectProjectionObstruction {HU QU HOld QOld : Type} (qU : HU → QU)
    (interpret : HU → HOld) (qOld : HOld → QOld) : (HU × HU) → Prop :=
  splitPairObstruction qU interpret qOld

/-- No object-projection obstruction is present. -/
def ObjectProjectionObstructionEmpty {HU QU HOld QOld : Type} (qU : HU → QU)
    (interpret : HU → HOld) (qOld : HOld → QOld) : Prop :=
  ObstructionEmpty (ObjectProjectionObstruction qU interpret qOld)

/-- Object projection with a specified quotient map `π : Q_U -> Q_old`. -/
def ObjectProjectionWithMap {HU QU HOld QOld : Type} (qU : HU → QU)
    (interpret : HU → HOld) (qOld : HOld → QOld) (π : QU → QOld) : Prop :=
  π ∘ qU = qOld ∘ interpret

/-- A common refinement carries both old object quotients as shadows. -/
def CommonRefinement {HU QU HA QA HB QB : Type} (qU : HU → QU)
    (interpretA : HU → HA) (qA : HA → QA)
    (interpretB : HU → HB) (qB : HB → QB) : Prop :=
  ObjectProjectionDescends qU interpretA qA ∧
    ObjectProjectionDescends qU interpretB qB

/-- Law/status carriage: every old law or claim has a lifted unified claim
whose status agrees with the declared status map. -/
def LawStatusCarriage {OldClaim UnifiedClaim OldStatus UnifiedStatus : Type}
    (lift : OldClaim → UnifiedClaim) (oldStatus : OldClaim → OldStatus)
    (unifiedStatus : UnifiedClaim → UnifiedStatus)
    (statusMap : OldStatus → UnifiedStatus) : Prop :=
  ∀ claim, unifiedStatus (lift claim) = statusMap (oldStatus claim)

/-- Law/status obstruction: a lifted claim has the wrong status. -/
def LawStatusObstruction {OldClaim UnifiedClaim OldStatus UnifiedStatus : Type}
    (lift : OldClaim → UnifiedClaim) (oldStatus : OldClaim → OldStatus)
    (unifiedStatus : UnifiedClaim → UnifiedStatus)
    (statusMap : OldStatus → UnifiedStatus) : OldClaim → Prop :=
  fun claim => unifiedStatus (lift claim) ≠ statusMap (oldStatus claim)

/-- No law/status obstruction is present. -/
def LawStatusObstructionEmpty {OldClaim UnifiedClaim OldStatus UnifiedStatus : Type}
    (lift : OldClaim → UnifiedClaim) (oldStatus : OldClaim → OldStatus)
    (unifiedStatus : UnifiedClaim → UnifiedStatus)
    (statusMap : OldStatus → UnifiedStatus) : Prop :=
  ObstructionEmpty (LawStatusObstruction lift oldStatus unifiedStatus statusMap)

/-- Transport preservation for a route shadow: projecting after the unified
route agrees with applying the old route after projection. -/
def TransportPreserved {QU QOld : Type} (π : QU → QOld)
    (routeU : QU → QU) (routeOld : QOld → QOld) : Prop :=
  ∀ u, π (routeU u) = routeOld (π u)

/-- Transport obstruction: a route diagram fails to commute at one parent
object. -/
def TransportObstruction {QU QOld : Type} (π : QU → QOld)
    (routeU : QU → QU) (routeOld : QOld → QOld) : QU → Prop :=
  fun u => π (routeU u) ≠ routeOld (π u)

/-- No transport obstruction is present. -/
def TransportObstructionEmpty {QU QOld : Type} (π : QU → QOld)
    (routeU : QU → QU) (routeOld : QOld → QOld) : Prop :=
  ObstructionEmpty (TransportObstruction π routeU routeOld)

/-- Role preservation is kept as a declared typed gate: sources, targets,
records, residuals, laws, boundaries, and audits must keep their role map. -/
def RolePreservation (roleGate : Prop) : Prop :=
  roleGate

/-- Cross-residual closure: every residual generated by putting the two law
structures in the parent package passes its declared status gate. -/
def CrossResidualClosed {CrossResidual : Type}
    (residualPassesStatus : CrossResidual → Prop) : Prop :=
  ∀ residual, residualPassesStatus residual

/-- Cross-residual obstruction: an unstatused or failed cross residual. -/
def CrossResidualObstruction {CrossResidual : Type}
    (residualPassesStatus : CrossResidual → Prop) : CrossResidual → Prop :=
  fun residual => ¬ residualPassesStatus residual

/-- No cross-residual obstruction is present. -/
def CrossResidualObstructionEmpty {CrossResidual : Type}
    (residualPassesStatus : CrossResidual → Prop) : Prop :=
  ObstructionEmpty (CrossResidualObstruction residualPassesStatus)

/-- Exact unification is the six-gate parent-package condition. Law and
transport gates are split for the A and B shadows. -/
def ExactUnifier (parentFormed objectA objectB lawA lawB transportA transportB
    rolePreserved crossResidualsClosed : Prop) : Prop :=
  parentFormed ∧ objectA ∧ objectB ∧ lawA ∧ lawB ∧ transportA ∧ transportB ∧
    rolePreserved ∧ crossResidualsClosed

/-- Substantive unification is exact unification plus an anti-product or
compression/shared-structure witness. -/
def SubstantiveUnifier (exactUnifier antiProductOrCompression : Prop) : Prop :=
  exactUnifier ∧ antiProductOrCompression

/-- Product juxtaposition carries both packages side by side but does not by
itself establish substantive unification. -/
def ProductJuxtaposition (exactUnifier productEquivalent : Prop) : Prop :=
  exactUnifier ∧ productEquivalent

/-- Partial unification records that only declared subpackages are carried. -/
def PartialUnification (subpackageSpecified subpackageUnifies : Prop) : Prop :=
  subpackageSpecified ∧ subpackageUnifies

/-- Approximate/asymptotic unification keeps a residual budget or limit status,
so it is not exact unification. -/
def BudgetedUnification (residualBudgeted : Prop) : Prop :=
  residualBudgeted

/-- Source status vocabulary for F51 unification claims. -/
